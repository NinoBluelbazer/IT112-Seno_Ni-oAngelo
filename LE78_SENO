#include <stdio.h>

int main()
{
    int numbers[10];
    int n;
    int i;
    int largest;

    char word[100];
    int count = 0;

    printf("How many numbers? ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter number %d: ", i + 1);
        scanf("%d", &numbers[i]);
    }

    largest = numbers[0];

    for (i = 1; i < n; i++)
    {
        if (numbers[i] > largest)
        {
            largest = numbers[i];
        }
    }

    printf("\nLargest number: %d\n", largest);

    printf("\nEnter a word or sentence: ");
    scanf(" %[^\n]", word);

    for (i = 0; word[i] != '\0'; i++)
    {
        if (word[i] == 'a' || word[i] == 'e' ||
            word[i] == 'i' || word[i] == 'o' ||
            word[i] == 'u')
        {
            count++;
        }
    }

    printf("Number of vowels: %d\n", count);

    return 0;
}
