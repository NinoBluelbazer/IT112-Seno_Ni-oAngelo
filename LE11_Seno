#include <stdio.h>

int main()
{
    FILE *file;
    int id, choice;
    char name[100], section[50];
    char line[200];

    do
    {
        printf("\nEnter Student Number: ");
        scanf("%d", &id);

        printf("Enter Complete Name: ");
        scanf(" %[^\n]", name);

        printf("Enter Section: ");
        scanf(" %[^\n]", section);

        file = fopen("student_records.txt", "a");

        if (file == NULL)
        {
            printf("File cannot be opened.");
            return 1;
        }

        fprintf(file, "ID Number: %d\n", id);
        fprintf(file, "Complete Name: %s\n", name);
        fprintf(file, "Section: %s\n\n", section);

        fclose(file);

        printf("\nRecord added and saved successfully.\n");

        printf("\nAdd another student? [Enter 1 for Yes, 0 for No]: ");
        scanf("%d", &choice);

    } while (choice == 1);

    printf("\nAll student records have been saved.\n");

    file = fopen("student_records.txt", "r");

    if (file == NULL)
    {
        printf("File cannot be opened.");
        return 1;
    }

    printf("\n--- STUDENT RECORDS ---\n");

    while (fgets(line, sizeof(line), file) != NULL)
    {
        printf("%s", line);
    }

    fclose(file);

    return 0;
}
