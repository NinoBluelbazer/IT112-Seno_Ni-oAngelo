#include <stdio.h>

int main()
{
    float balance = 500;
    float amount;
    int choice;

    do
    {
        printf("\n===== ATM MENU =====\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Balance: P%.2f\n", balance);
                break;

            case 2:
                printf("Enter deposit: P");
                scanf("%f", &amount);

                balance = balance + amount;

                printf("New balance: P%.2f\n", balance);
                break;

            case 3:
                printf("Enter withdrawal: P");
                scanf("%f", &amount);

                if (balance - amount < 100)
                {
                    printf("Withdrawal denied!\n");
                    printf("You must maintain at least P100.00 in your account\n");
                }
                else
                {
                    balance = balance - amount;
                    printf("New balance: P%.2f\n", balance);
                }
                break;

            case 4:
                printf("Thank you for using the ATM!\n");
                break;

            default:
                printf("Invalid choice!\n");
        }

    } while(choice != 4);

    return 0;
}
