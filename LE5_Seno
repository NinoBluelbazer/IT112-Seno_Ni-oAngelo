#include <stdio.h>

int main() {
    int numb;
    int total = 0;

    printf("Enter a positive number to ADD (zero or negative to STOP) \n");
    
    
    printf("\n");
    
    printf("Enter a number: ");
    scanf("%d", &numb);

    while (numb > 0) {
        total += numb;

        printf("Enter a number: ");
        scanf("%d", &numb);
    }

    printf("Total sum is: %d", total);

    return 0;
}
